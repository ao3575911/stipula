# Telegram bot token from @BotFather. Never commit a real value.
BOT_TOKEN=

# Numeric Telegram user id allowed to run /health, /grant, and /revoke.
BOT_OWNER_ID=

# SQLite file. The parent directory is created on startup.
DATABASE_PATH=./data/stipula.sqlite3

# DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# JSON logs. Set empty to log only to stdout.
LOG_PATH=./data/stipula.log.jsonl

# false hashes Telegram user and chat ids in logs. true stores the raw ids.
LOG_USER_IDS=false

# Salt for those hashes. Change this before any real deployment.
LOG_SALT=change-me

# Free plan. Accepting or fulfilling a commitment does not spend another seal.
MONTHLY_FREE_SEALS=30
FREE_OPEN_COMMITMENTS=5

# Bot API getFile refuses anything larger. Do not raise this above 20971520.
MAX_FILE_BYTES=20971520

# Commands and callbacks per user per minute, in this process only.
RATE_LIMIT_PER_MINUTE=20

# How long /seal or /verify waits for the next message.
PENDING_TTL_SECONDS=600
